{
  "manifest_version": 3,
  "name": "QuestLoader",
  "version": "release",
  "description": "Custom Quest binary downloader extension.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "cookies"
  ],
  "host_permissions": [
    "https://*.meta.com/*",
    "https://*.oculus.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.meta.com/*",
        "https://*.oculus.com/*"
      ],
      "js": [
        "QuestLoader.js"
      ],
      "css": [
        "style.css"
      ]
    }
  ]
}

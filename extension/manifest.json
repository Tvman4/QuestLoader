{
  "manifest_version": 3,
  "name": "QuestLoader",
  "version": "1.0",
  "description": "Custom Quest binary downloader.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "cookies"
  ],
  "host_permissions": [
    "https://*.meta.com/*",
    "https://*.oculus.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.meta.com/experiences/*"],
      "js": ["content.js"]
    }
  ]
}
